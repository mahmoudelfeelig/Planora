    "forbidden_inputs": [
      "competitor source code, bytecode, decompilation, or translated control flow",
      "competitor move traces or entity-level assignments used to construct a Planora-native result",
      "benchmark instance identifiers, comparator scores, or target thresholds in operator decisions",
      "claims that a postprocessor starting from a competitor solution is a Planora-native win"
    ],
    "implementation_rules": [
      "derive selectors from the current problem representation and independently scored incumbent",
